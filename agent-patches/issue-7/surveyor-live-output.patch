diff --git a/tests/test_workflow_stream.py b/tests/test_workflow_stream.py
new file mode 100644
index 0000000..b24ef1c
--- /dev/null
+++ b/tests/test_workflow_stream.py
@@ -0,0 +1,68 @@
+import importlib.util
+import queue
+import sys
+import tempfile
+import time
+import types
+import unittest
+from pathlib import Path
+from unittest.mock import patch
+
+
+SOURCE = Path(__file__).resolve().parents[1] / "tools" / "surveyor_controller.py"
+sys.path.insert(0, str(SOURCE.parent))
+try:
+    import tkinter  # noqa: F401
+except ImportError:
+    tkinter = types.ModuleType("tkinter")
+    tkinter.StringVar = type("StringVar", (), {})
+    tkinter.ttk = types.ModuleType("tkinter.ttk")
+    tkinter.ttk.Widget = type("Widget", (), {})
+    tkinter.messagebox = types.ModuleType("tkinter.messagebox")
+    sys.modules.update({"tkinter": tkinter, "tkinter.ttk": tkinter.ttk,
+                        "tkinter.messagebox": tkinter.messagebox})
+spec = importlib.util.spec_from_file_location("surveyor_controller", SOURCE)
+controller_module = importlib.util.module_from_spec(spec)
+spec.loader.exec_module(controller_module)
+
+
+class WorkflowStreamTests(unittest.TestCase):
+    def test_output_arrives_before_exit_and_failure_skips_upload(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            root = Path(tmp)
+            controller = controller_module.SurveyorController.__new__(controller_module.SurveyorController)
+            controller.project_root = root
+            controller.workflow_running = False
+            controller.output_events = queue.SimpleQueue()
+            controller._set_status = lambda *_args: None
+            controller.window = type("Window", (), {"after": lambda _self, _ms, callback: callback()})()
+            command = [sys.executable, "-u", "-c", "import sys,time; print('started', flush=True); time.sleep(.4); print('progress 50%', flush=True); print('error detail', file=sys.stderr, flush=True); sys.exit(3)"]
+            upload = [sys.executable, "-c", "print('upload should not run')"]
+            with patch.object(controller_module, "LOG_DIR", root), \
+                 patch.object(controller_module, "WORKFLOW_LOG", root / "workflow.log"), \
+                 patch.object(controller_module, "WORKFLOW_DIAGNOSTIC", root / "diagnostic.txt"):
+                controller._run_steps("Test action", [("Research", command), ("Upload", upload)])
+                deadline = time.monotonic() + 5
+                early = []
+                while time.monotonic() < deadline and "started\n" not in early:
+                    try:
+                        kind, value = controller.output_events.get_nowait()
+                        if kind == "line":
+                            early.append(value)
+                    except queue.Empty:
+                        time.sleep(.01)
+                self.assertIn("started\n", early)
+                self.assertTrue(controller.workflow_running)
+                while controller.workflow_running and time.monotonic() < deadline:
+                    time.sleep(.01)
+                self.assertFalse(controller.workflow_running)
+                log = (root / "latest-test-action.log").read_text(encoding="utf-8")
+                self.assertIn("progress 50%", log)
+                self.assertIn("error detail", log)
+                self.assertNotIn("upload should not run", log)
+                self.assertEqual(controller._latest_output, "Exit status: 3")
+                self.assertEqual(controller._latest_progress, "progress 50%")
+
+
+if __name__ == "__main__":
+    unittest.main()
