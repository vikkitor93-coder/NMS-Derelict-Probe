+import importlib.util
+from pathlib import Path
+import unittest
+
+ROOT = Path(__file__).resolve().parents[1]
+SPEC = importlib.util.spec_from_file_location("github_integration", ROOT / "tools" / "github_integration.py")
+github_integration = importlib.util.module_from_spec(SPEC)
+assert SPEC.loader
+SPEC.loader.exec_module(github_integration)
+
+
+class EvidenceNamespaceTests(unittest.TestCase):
+    def test_unscoped_upload_path_is_backward_compatible(self):
+        self.assertEqual(
+            "research-uploads/20260930T190000Z-measure",
+            github_integration.evidence_folder("20260930T190000Z", "measure"),
+        )
+
+    def test_lane_extension_gets_unique_timestamped_namespace(self):
+        first = github_integration.evidence_folder("20260930T190000Z", "extract-exact-root-caller", "dungeon-decompile")
+        second = github_integration.evidence_folder("20260930T190000Z", "extract-exact-root-caller", "dungeon-decompile")
+        self.assertRegex(first, r"^research-uploads/20260930T190000Z-dungeon-decompile-extract-exact-root-caller-[0-9a-f]{8}$")
+        self.assertNotEqual(first, second)
+
+    def test_unsafe_namespace_is_rejected(self):
+        with self.assertRaisesRegex(RuntimeError, "Invalid agent evidence namespace"):
+            github_integration.evidence_folder("20260930T190000Z", "measure", "../other")
+
+
+if __name__ == "__main__":
+    unittest.main()
