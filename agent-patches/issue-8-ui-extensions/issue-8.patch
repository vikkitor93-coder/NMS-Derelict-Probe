+import hashlib
+import importlib.util
+import json
+import tempfile
+import unittest
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parents[1]
+SPEC = importlib.util.spec_from_file_location("agent_ui_extensions", ROOT / "tools" / "agent_ui_extensions.py")
+extensions = importlib.util.module_from_spec(SPEC)
+assert SPEC.loader
+SPEC.loader.exec_module(extensions)
+
+
+def package(extension_id="test-lane", version="1.0.0", summary="Panel"):
+    panel = {
+        "schema_version": 1,
+        "title": "Test extension",
+        "summary": summary,
+        "actions": [{
+            "action_id": "research.extract_exact_root_caller",
+            "label": "Extract caller",
+            "description": "Use the host action.",
+            "preconditions": ["workflow.idle"],
+            "evidence_namespace": extension_id,
+            "parameters": {},
+        }],
+    }
+    panel_bytes = (json.dumps(panel, sort_keys=True) + "\n").encode()
+    manifest = {
+        "schema_version": 1,
+        "extension_id": extension_id,
+        "version": version,
+        "compatible_surveyor_api_version": "1.0",
+        "min_surveyor_version": "0.3.41",
+        "dependencies": ["agent-console.ui.v1", "action.research.extract_exact_root_caller"],
+        "entry_point": "panel.json",
+        "files": [{"path": "panel.json", "sha256": hashlib.sha256(panel_bytes).hexdigest()}],
+    }
+    entry = {"extension_id": extension_id, "version": version, "manifest_path": f"{extension_id}/{version}/manifest.json"}
+    url_base = extensions.REMOTE_BASE
+    remote = {
+        url_base + entry["manifest_path"]: (json.dumps(manifest) + "\n").encode(),
+        url_base + f"{extension_id}/{version}/panel.json": panel_bytes,
+    }
+    return entry, manifest, panel, remote
+
+
+class AgentUIExtensionTests(unittest.TestCase):
+    def test_published_dungeon_decompile_sample_matches_contract(self):
+        folder = ROOT / "agent-ui" / "extensions" / "dungeon-decompile" / "1.0.0"
+        manifest = json.loads((folder / "manifest.json").read_text(encoding="utf-8"))
+        validated, panel = extensions.validate_manifest(
+            manifest,
+            "dungeon-decompile",
+            "1.0.0",
+            "0.3.41",
+            lambda rel: (folder / rel).read_bytes(),
+            extensions.HOST_ACTION_IDS,
+        )
+        self.assertEqual("dungeon-decompile", validated["extension_id"])
+        self.assertEqual("DUNGEON-C · Offline caller evidence", panel["title"])
+        self.assertEqual("dungeon-decompile", panel["actions"][0]["evidence_namespace"])
+
+    def test_installs_valid_data_only_panel_and_activates_it(self):
+        entry, _manifest, _panel, remote = package()
+        with tempfile.TemporaryDirectory() as tmp:
+            manifest, panel = extensions.install_extension(Path(tmp), entry, "0.3.41", extensions.HOST_ACTION_IDS, remote.__getitem__)
+            self.assertEqual("test-lane", manifest["extension_id"])
+            self.assertEqual("Test extension", panel["title"])
+            loaded = extensions.load_installed_extension(Path(tmp), "test-lane", "0.3.41", extensions.HOST_ACTION_IDS)
+            self.assertEqual("1.0.0", loaded[0]["version"])
+
+    def test_failed_update_keeps_previous_version_active(self):
+        first, _, _, first_remote = package(version="1.0.0", summary="Old")
+        second, _, _, second_remote = package(version="1.1.0", summary="New")
+        with tempfile.TemporaryDirectory() as tmp:
+            root = Path(tmp)
+            extensions.install_extension(root, first, "0.3.41", extensions.HOST_ACTION_IDS, first_remote.__getitem__)
+            broken = dict(second_remote)
+            panel_url = extensions.REMOTE_BASE + "test-lane/1.1.0/panel.json"
+            broken[panel_url] = b'{"schema_version":1,"title":"tampered"}'
+            with self.assertRaises(extensions.ExtensionError):
