+    def test_overlay_surfaces_owner_plus_0x10_capture_and_target_identity(self):
+        status = {
+            "heartbeat_epoch": 1000.0,
+            "probe_version": "0.3.34",
+            "state": "ready",
+            "recording": False,
+            "generation_rooms": {
+                "last_dungeon_logical_entry_exact_external_caller_offset_hex": "02C0497A",
+                "last_dungeon_root_owner_plus_0x10_capture": {
+                    "read_status": "captured",
+                    "slot_value_hex": "00007FF612345678",
+                    "target_identity": {
+                        "status": "loaded-module",
+                        "module_rva_hex": "01234567",
+                    },
+                },
+            },
+        }
+        view = overlay_mod.summarize_status(status, now_epoch=1000.5)
+        self.assertIn("+0x10 captured", view["exact_root_caller"])
+        self.assertIn("ROOT+0x10 00007FF612345678 -> NMS+01234567", view["generation"])
+
+    def test_v0334_captures_owner_slot_only_after_exact_root_descriptor_match(self):
